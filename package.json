{
  "name": "pear",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run vendor && dotenv -- tauri dev",
    "build": "npm run vendor && dotenv -- tauri build --config app/tauri.bundle.conf.json",
    "dev:ui": "vite",
    "build:ui": "tsc --noEmit && vite build",
    "vendor": "pwsh scripts/vendor-deps.ps1",
    "vendor:force": "pwsh scripts/vendor-deps.ps1 -Force",
    "preview": "vite preview",
    "tauri": "tauri",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-toastify": "^11.1.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
